# --- ASP.NET ---
ASPNETCORE_ENVIRONMENT=Production

# --- Telegram ---
Telegram__Token=<TELEGRAM_BOT_TOKEN_PLACEHOLDER>
# AdminIds можно перечислять так:
Telegram__AdminIds__0=<TELEGRAM_ADMIN_ID_PLACEHOLDER>
# Telegram__AdminIds__1=<TELEGRAM_ADMIN_ID_PLACEHOLDER_2>

# --- 3x-ui ---
XUi__ApiUrl=http://host.docker.internal:2053/<WEB_BASE_PATH>/
XUi__ApiToken=<API_TOKEN>
XUi__InboundId=1


# --- Database (SQLite in volume ./data -> /data) ---
# Подстройте ключ под вашу AddEfCoreConfiguration:
# если она читает ConnectionStrings:Sqlite (как в вашем appsettings.json) — используйте строку ниже:
ConnectionStrings__Sqlite=Data Source=/data/vpn_bot.db