# Образец переменных для docker-compose.yml.
# Локально: скопируйте в .env (он не попадает в git) и впишите значения.
# Portainer: вставьте эти строки в Stack → Environment variables → Advanced mode.

# --- Telegram (обязательно) ---
TELEGRAM_TOKEN=123456789:AAAA-токен-от-BotFather
TELEGRAM_ADMIN_ID=111111111

# --- 3x-ui (обязательно) ---
# Адрес панели вместе с webBasePath, слэш в конце
XUI_API_URL=http://host.docker.internal:2053/WEB_BASE_PATH/
# Settings -> Security -> API Token
XUI_API_TOKEN=

# --- amnezia-wg-easy (необязательно) ---
# false — отключить AmneziaWG
AMNEZIA_ENABLED=true
AMNEZIA_API_URL=http://host.docker.internal:51821/
# PASSWORD контейнера amnezia-wg-easy
AMNEZIA_PASSWORD=
